<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Kleinia Project</vendor>
  <vendor_url>https://kleinia.io</vendor_url>

  <action id="io.kleinia.schedmgr.apply">
    <description>Change kernel scheduling policies</description>
    <description xml:lang="zh_CN">更改内核调度策略（CPU 调度器 / 页缓存 / IO）</description>
    <message>Authentication is required to change kernel scheduling policies (CPU scheduler, page cache eviction, per-device IO scheduler)</message>
    <message xml:lang="zh_CN">更改内核调度策略（进程调度器、页缓存换出、每设备 IO 调度）需要认证</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/schedmgrd</annotate>
  </action>

</policyconfig>
